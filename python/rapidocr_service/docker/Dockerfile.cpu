FROM python:3.12-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=Asia/Shanghai \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple \
    PIP_EXTRA_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple \
    PIP_TRUSTED_HOST="mirrors.aliyun.com pypi.tuna.tsinghua.edu.cn"

WORKDIR /app

COPY docker/pip.conf /etc/pip.conf

RUN apt-get update && apt-get install -y --no-install-recommends \
        libglib2.0-0 \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY versions.env /tmp/versions.env
COPY docker/warmup_models.py /tmp/warmup_models.py

RUN set -eux; \
    . /tmp/versions.env; \
    python -m pip install --no-cache-dir --upgrade pip; \
    pip install --no-cache-dir \
        "rapidocr_api==${RAPIDOCR_API_VERSION}" \
        "rapidocr==${RAPIDOCR_VERSION}" \
        "onnxruntime==${ONNXRUNTIME_VERSION}"; \
    pip uninstall -y opencv-python || true; \
    pip install --no-cache-dir opencv-python-headless; \
    python /tmp/warmup_models.py; \
    rm -f /tmp/warmup_models.py /tmp/versions.env

EXPOSE 9003

CMD ["rapidocr_api", "-ip", "0.0.0.0", "-p", "9003", "-workers", "4"]
